#!/usr/bin/make -f
# Generated from packages/desktop/debian/rules.in by scripts/render.py. Edit the .in file, not this one.
# Builds the five desktop packages from the ported Omarchy tree (see README.md and
# debian/install-tree.sh). The tree arrives with Omarchy's names; the build copies what it
# installs to debian/renamed/, runs the port's rename script on that copy with the identity
# from distro.conf, and installs from the copy.
ID = oaxaca
NAME = Oaxaca
UPPER = OAXACA
R = debian/renamed
UPSTREAM_VERSION = $(shell dpkg-parsechangelog -S Version | sed 's/-[^-]*$$//')
export DISTRO_ID = $(ID)
export DISTRO_NAME = $(NAME)
export DISTRO_ID_UPPER = $(UPPER)
export DISTRO_HOME_URL = https://github.com/santisbon/oaxaca
export DISTRO_BUG_URL = https://github.com/santisbon/oaxaca/issues
# owner/name of the Omarchy fork on GitHub, kept unrenamed by port/rename.sh: the agent skills
# (default/agents/skills) send bug reports there.
export DISTRO_FORK_REPO = $(patsubst https://github.com/%,%,https://github.com/santisbon/omarchy)

%:
	dh $@

override_dh_auto_build:
	rm -rf $(R)
	mkdir -p $(R)
	# migrations/ too: install-tree.sh ships $(R)/migrations/*.sh. It was missing from this list until
	# 2026-10-14, when the port's first migration came out of the package unshipped.
	cp -a bin config default applications themes shell install etc port migrations logo.svg logo.txt icon.png icon.txt $(R)/
	bash $(R)/port/rename.sh --tree $(R)
	# Omarchy's "version" file is not maintained (policy, section 3); the package version is.
	printf '%s\n' '$(UPSTREAM_VERSION)' > $(R)/version
	# Branding: placeholders made from the distro's name until the distro has artwork.
	# The text ones are templates in debian/extra; the images are rendered here.
	cp debian/extra/logo.txt $(R)/logo.txt
	cp debian/extra/icon.txt $(R)/icon.txt
	cp debian/extra/logo.svg $(R)/logo.svg
	magick -background none -fill white -font DejaVu-Sans-Bold -pointsize 44 -size 256x256 -gravity center 'label:$(NAME)' PNG32:$(R)/icon.png
	cp $(R)/icon.png $(R)/default/sddm/$(ID)/logo.png
	cp $(R)/icon.png $(R)/default/plymouth/logo.png
	# Application icons in the sizes the freedesktop icon lookup expects (Omarchy's recipe).
	mkdir -p $(R)/icons/256x256 $(R)/icons/48x48 $(R)/icons/scalable
	set -e; for icon in $(R)/applications/icons/*; do \
	  [ -f "$$icon" ] || continue; \
	  name=$$(basename "$$icon"); name=$${name%.*}; \
	  name=$$(printf '%s' "$$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$$//'); \
	  case "$$icon" in \
	    *.svg) cp "$$icon" "$(R)/icons/scalable/$$name.svg" ;; \
	    *) magick "$$icon" -thumbnail 256x256 -background transparent -gravity center -extent 256x256 "PNG32:$(R)/icons/256x256/$$name.png"; \
	       magick "$$icon" -thumbnail 48x48 -background transparent -gravity center -extent 48x48 "PNG32:$(R)/icons/48x48/$$name.png" ;; \
	  esac; \
	done

override_dh_auto_install:
	bash debian/install-tree.sh $(R)

# debhelper wants debian/<package>.postinst and friends; the templates keep the distro's name
# out of file names, so the copies are made here and listed in debian/clean.
override_dh_installdeb:
	cp debian/config.postinst debian/$(ID)-config.postinst
	cp debian/config.prerm debian/$(ID)-config.prerm
	dh_installdeb

override_dh_lintian:
	cp debian/config.lintian-overrides debian/$(ID)-config.lintian-overrides
	dh_lintian

override_dh_fixperms:
	dh_fixperms
	chmod 0440 debian/$(ID)-config/etc/sudoers.d/*

# The metapackage's dependency list comes from the ported package list in the tree, one
# Ubuntu package name per line, comments allowed.
override_dh_gencontrol:
	printf 'port:Depends=%s\n' "$$(grep -v '^#' $(R)/install/$(ID)-base.packages | grep -v '^[[:space:]]*$$' | paste -sd, | sed 's/,/, /g')" >> debian/$(ID)-desktop.substvars
	dh_gencontrol
