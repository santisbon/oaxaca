 -- @MAINTAINER@  Sun, 18 Oct 2026 14:30:00 -0500

@DISTRO_ID@-desktop (4.0.4+git20261018.98.e07d28a1-0@DISTRO_ID@1) @BASE_SERIES@; urgency=medium

