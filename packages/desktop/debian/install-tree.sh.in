#!/bin/bash
# install-tree.sh <renamed tree>: lay the renamed Omarchy tree out into the four binary
# packages' staging directories (debian/<package>/). It follows Omarchy's own two recipes
# (omarchy and omarchy-settings in omacom/omarchy-pkgs) file for file, with these differences:
# the fonts go under /usr/share/fonts/truetype/<id>/ (Debian's layout); the Wayland session
# file goes to /usr/share/wayland-sessions (not /usr/local); bash's /etc/skel/.bashrc stays Ubuntu's and
# a /etc/skel/.bash_aliases, which that file sources, pulls in Omarchy's shell defaults; there is no etc-overrides directory, because the
# files it carried are either the distro's own (os-release), not applicable on Ubuntu
# (faillock, nsswitch) or carried to a later step (cups, plymouthd.conf); SDDM's Wayland
# greeter file is not here (the session package has it); migrations/ is shipped as the branch
# carries it, which since 2026-10-11 is the port's own migrations only (its README).
set -euo pipefail
R=${1:?renamed tree}
id=@DISTRO_ID@
share=usr/share/$id
tools=debian/$id-tools
shell=debian/$id-shell
themes=debian/$id-themes
config=debian/$id-config

# ---- tools: the commands, the install tree, the version
install -d "$tools/usr/bin" "$tools/$share/bin"
for f in "$R"/bin/*; do
  [[ -f $f ]] || continue
  b=$(basename "$f")
  install -D -m 0755 "$f" "$tools/usr/bin/$b"
  ln -s "/usr/bin/$b" "$tools/$share/bin/$b"
done
# Ubuntu names these two binaries fdfind and batcat (name clashes in Debian's archive).
ln -s fdfind "$tools/usr/bin/fd"
ln -s batcat "$tools/usr/bin/bat"
cp -a "$R/install" "$tools/$share/install"
install -D -m 0644 "$R/version" "$tools/$share/version"
# The migrations directory always exists in the package, so omarchy-migrate-notify.service's
# ConditionPathIsDirectory holds and the runner has a fixed place to look, even with no migration yet.
install -d "$tools/$share/migrations"
for f in "$R"/migrations/*.sh; do
  [[ -f $f ]] && install -m 0644 "$f" "$tools/$share/migrations/"
done

# ---- shell: the Quickshell tree and the icon font
install -d "$shell/$share"
cp -a "$R/shell" "$shell/$share/shell"
install -D -m 0644 "$R/default/fonts/$id/$id.ttf" "$shell/usr/share/fonts/truetype/$id/$id.ttf"

# ---- themes: the bundles and the templates
install -d "$themes/$share/default"
cp -a "$R/themes" "$themes/$share/themes"
cp -a "$R/default/themed" "$themes/$share/default/themed"

# ---- config: defaults, skel, system files
# /etc/skel/.config seeds new users; /usr/share/<id>/config is what existing users resync from.
install -d "$config/etc/skel/.config" "$config/$share/config" "$config/$share/default"
cp -a "$R/config/." "$config/etc/skel/.config/"
cp -a "$R/config/." "$config/$share/config/"
cp -a "$R/default/." "$config/$share/default/"
rm -rf "$config/$share/default/themed" "$config/$share/default/fonts"
# Ubuntu's skel .bashrc sources ~/.bash_aliases when present; that is where the shell defaults hook in.
install -D -m 0644 "$R/default/bash_aliases" "$config/etc/skel/.bash_aliases"
# /etc drop-ins the package owns outright.
install -d "$config/etc"
cp -a "$R/etc/." "$config/etc/"
mv "$config/etc/sddm.conf.d/10-theme.conf" "$config/etc/sddm.conf.d/10-$id-theme.conf"
# tmpfiles.d entries belong under /usr/lib (lintian: misplaced-systemd-tmpfiles); Omarchy keeps them in etc/.
install -d "$config/usr/lib/tmpfiles.d"
mv "$config"/etc/tmpfiles.d/*.conf "$config/usr/lib/tmpfiles.d/"
rmdir "$config/etc/tmpfiles.d"
install -D -m 0644 debian/extra/apt-periodic.conf "$config/etc/apt/apt.conf.d/20$id-periodic"
# Makes the Debian Chromium launcher read ~/.config/chromium-flags.conf (the file says why).
install -D -m 0644 debian/extra/chromium-user-flags "$config/etc/chromium.d/zz-$id-user-flags"
# Package-owned defaults at their XDG and systemd locations; user files override them.
install -D -m 0644 "$R/default/uwsm/env.d/10-$id" "$config/usr/share/uwsm/env.d/10-$id"
install -D -m 0644 "$R/default/environment.d/10-$id-fcitx.conf" "$config/usr/lib/environment.d/10-$id-fcitx.conf"
install -D -m 0644 "$R/default/fontconfig/conf.avail/50-$id.conf" "$config/usr/share/fontconfig/conf.avail/50-$id.conf"
install -d "$config/etc/fonts/conf.d"
ln -s "/usr/share/fontconfig/conf.avail/50-$id.conf" "$config/etc/fonts/conf.d/50-$id.conf"
install -D -m 0644 "$R/default/xdg-terminal-exec/hyprland-xdg-terminals.list" "$config/usr/share/xdg-terminal-exec/hyprland-xdg-terminals.list"
install -D -m 0644 "$R/default/applications/mimeapps.list" "$config/usr/share/applications/mimeapps.list"
install -d "$config/usr/lib/systemd/user" "$config/usr/lib/systemd/system-sleep"
# The user units Omarchy's recipe installs system-wide. Not the speaker tuning one: that unit is
# copied into a user's ~/.config/systemd/user by "<id>-audio-tuning on", and only on a laptop a
# tuning matches; installed here it would be started by its WantedBy and loop on a missing config.
for unit in "$R"/default/systemd/user/*.service; do
  [[ $(basename "$unit") == "$id-speaker-tuning.service" ]] && continue
  install -m 0644 "$unit" "$config/usr/lib/systemd/user/"
done
# The pam-auth-update profile the FIDO2 setup enables (libpam-u2f ships none); off by default.
install -D -m 0644 "$R/default/pam-configs/$id-u2f" "$config/usr/share/pam-configs/$id-u2f"
install -m 0755 "$R/default/systemd/system-sleep/unmount-fuse" "$config/usr/lib/systemd/system-sleep/unmount-fuse"
# systemd-oomd's scope (docs/6, choice 45): only the user's apps (app.slice) are kill candidates,
# and the user manager, which Ubuntu's systemd-oomd marks, is set back to auto.
install -D -m 0644 "$R/default/systemd/user/app.slice.d/10-oomd.conf" "$config/usr/lib/systemd/user/app.slice.d/10-oomd.conf"
install -D -m 0644 "$R/default/systemd/system/user@.service.d/20-$id-oomd.conf" "$config/usr/lib/systemd/system/user@.service.d/20-$id-oomd.conf"
# Application launchers: the resync copy only. Omarchy also seeds them through /etc/skel, but
# dpkg's conffile list cannot hold names with spaces ("Google Maps.desktop"), and the first
# login copies them into the home anyway (<id>-refresh-applications, run by <id>-provision-user).
install -d "$config/$share/applications"
cp "$R"/applications/*.desktop "$config/$share/applications/"
for size in 256x256 48x48 scalable; do
  install -d "$config/usr/share/icons/hicolor/$size/apps"
  cp "$R/icons/$size/"* "$config/usr/share/icons/hicolor/$size/apps/" 2>/dev/null || true
done
# SDDM theme, the Wayland session, the Plymouth theme (files only; the image step turns it on).
install -d "$config/usr/share/sddm/themes" "$config/usr/share/plymouth/themes/$id"
cp -a "$R/default/sddm/$id" "$config/usr/share/sddm/themes/$id"
find "$config/usr/share/sddm/themes/$id" -type d -exec chmod 0755 {} +
find "$config/usr/share/sddm/themes/$id" -type f -exec chmod 0644 {} +
install -D -m 0644 "$R/default/wayland-sessions/$id.desktop" "$config/usr/share/wayland-sessions/$id.desktop"
cp -a "$R/default/plymouth/." "$config/usr/share/plymouth/themes/$id/"
find "$config/usr/share/plymouth/themes/$id" -type d -exec chmod 0755 {} +
find "$config/usr/share/plymouth/themes/$id" -type f -exec chmod 0644 {} +
# Branding (placeholders, see README.md): the resync copies, the icon-theme lookups for
# os-release's LOGO, and the per-user seeds.
for f in logo.txt logo.svg icon.txt icon.png; do
  install -D -m 0644 "$R/$f" "$config/$share/$f"
done
install -D -m 0644 "$R/icon.png" "$config/usr/share/pixmaps/$id.png"
install -D -m 0644 "$R/icon.png" "$config/usr/share/icons/hicolor/256x256/apps/$id.png"
install -D -m 0644 "$R/logo.txt" "$config/etc/skel/.config/$id/branding/screensaver.txt"
install -D -m 0644 "$R/icon.txt" "$config/etc/skel/.config/$id/branding/about.txt"
# Static per-user defaults outside ~/.config.
install -D -m 0644 "$R/default/hypr/toggles/flags.lua" "$config/etc/skel/.local/state/$id/toggles/hypr/flags.lua"
install -D -m 0644 "$R/default/nautilus-python/extensions/transcode.py" "$config/etc/skel/.local/share/nautilus-python/extensions/transcode.py"
# Files' "Send via LocalSend": the extension offers itself only when a localsend command (the
# localsend package, a dependency of the desktop) or LocalSend's Flatpak is installed.
install -D -m 0644 "$R/default/nautilus-python/extensions/localsend.py" "$config/etc/skel/.local/share/nautilus-python/extensions/localsend.py"
install -D -m 0644 "$R/default/tensaku/state.toml" "$config/etc/skel/.local/state/tensaku/state.toml"
