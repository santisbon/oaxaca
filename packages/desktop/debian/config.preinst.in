#!/bin/sh
# Pause Hyprland's automatic config reload in every running session before this package's
# files are unpacked, so that no session reloads a half-written /usr/share/@DISTRO_ID@/default/hypr
# (docs/6, choice 44). Omarchy does the same from a pacman hook (PreTransaction on
# omarchy-settings); the postinst resumes and reloads once. The guard ships in
# @DISTRO_ID@-tools, so on a first install, or with that package absent, there is nothing to pause.
set -e
case "$1" in
  install|upgrade)
    if [ -x /usr/bin/@DISTRO_ID@-hyprland-reload-guard ]; then
      /usr/bin/@DISTRO_ID@-hyprland-reload-guard pause || true
    fi
    ;;
esac
#DEBHELPER#
