#!/bin/sh
# Register the distro's Plymouth theme the way Ubuntu's theme packages do: an alternative
# for default.plymouth (plymouth-theme-spinner registers bgrt at priority 110; 150 wins),
# then a rebuild of the initramfs, whose plymouth hook copies the selected theme in.
# stonking ships no plymouth-set-default-theme.
set -e
# Ask for a reboot the way Ubuntu's packages do: /run/reboot-required, with the package's name in
# /run/reboot-required.pkgs. @DISTRO_ID@-update offers the reboot when the file exists, and /run
# is a tmpfs, so the reboot clears it.
request_reboot() {
  if [ -d /run ]; then
    touch /run/reboot-required
    grep -qx '@DISTRO_ID@-config' /run/reboot-required.pkgs 2>/dev/null ||
      echo '@DISTRO_ID@-config' >> /run/reboot-required.pkgs
  fi
}
# Resume Hyprland's automatic config reload, paused by the preinst, with one reload of every
# running session (docs/6, choice 44). Also on the abort paths, so a failed upgrade does not leave
# the sessions paused.
resume_reload() {
  if command -v @DISTRO_ID@-hyprland-reload-guard >/dev/null; then
    @DISTRO_ID@-hyprland-reload-guard resume || true
  fi
}
case "$1" in
  abort-upgrade|abort-install|abort-remove|abort-deconfigure)
    resume_reload
    ;;
  configure)
    # Resume first: the files are already in place, and a failure below must not leave the
    # sessions paused.
    resume_reload
    # The Wi-Fi 7 fix is for a Dell XPS on Panther Lake only (docs/6, choice 60). Installs made
    # earlier wrote it on every machine with an Intel BE200 or BE211; take it back off the
    # others. The file is not a package file, and a migration runs as the user, so this is the
    # place; the initramfs rebuilt below then carries the change too.
    eht=/etc/modprobe.d/iwlwifi-disable-eht.conf
    if [ -f "$eht" ] && grep -q 'Temporary fix Dell XPS' "$eht" &&
      ! { grep -qi XPS /sys/class/dmi/id/product_name /sys/class/dmi/id/product_family 2>/dev/null &&
          lspci 2>/dev/null | grep -iE 'vga|3d|display' | grep -qi 'panther lake'; }; then
      rm -f "$eht"
      # iwlwifi keeps the option until it loads again.
      request_reboot
    fi
    # The firewall (docs/6, choice 40): install/config/firewall.sh turns ufw on at install since
    # desktop 4.0.4+git20261016.47; systems installed earlier have it off, and migrations run as
    # the user, without root. On an upgrade (not the image build, where $2 is empty), a system
    # without the marker firewall.sh writes gets the same state once, live: LocalSend's port and
    # ufw on. The marker then keeps a user's own "ufw disable" in force.
    marker=/var/lib/@DISTRO_ID@/firewall-on
    if [ -n "$2" ] && [ ! -e "$marker" ] && command -v ufw >/dev/null; then
      if grep -q '^ENABLED=no' /etc/ufw/ufw.conf 2>/dev/null; then
        ufw allow 53317/udp comment localsend >/dev/null || true
        ufw allow 53317/tcp comment localsend >/dev/null || true
        sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
        systemctl enable ufw >/dev/null 2>&1 || true
        ufw --force enable >/dev/null 2>&1 || echo "@DISTRO_ID@-config: ufw is on from the next boot" >&2
      fi
      mkdir -p /var/lib/@DISTRO_ID@
      touch "$marker"
    fi
    # The PATH for SSH commands (docs/6, choice 91): install/config/ssh-command-path.sh appends
    # mise's shims and ~/.local/bin to PAM's PATH in /etc/security/pam_env.conf at install; systems
    # installed before that script came back have no such line, and migrations run as the user,
    # without root. On an upgrade, a system without the marker the script writes gets the same line
    # once, unless pam_env.conf already has a PATH line of its own (the administrator's). The
    # marker then keeps a removed line removed. pam_env.conf is libpam-modules' conffile;
    # @DISTRO_ID@-update upgrades with --force-confold, which keeps the edited file.
    marker=/var/lib/@DISTRO_ID@/ssh-command-path
    conf=/etc/security/pam_env.conf
    if [ -n "$2" ] && [ ! -e "$marker" ] && [ -f "$conf" ]; then
      if ! grep -qE '^PATH[[:space:]]' "$conf"; then
        printf '\n# @DISTRO_NAME@: give SSH commands and other non-shell logins the user-level tool paths\nPATH DEFAULT=${PATH}:@{HOME}/.local/share/mise/shims:@{HOME}/.local/bin\n' >> "$conf"
      fi
      mkdir -p /var/lib/@DISTRO_ID@
      touch "$marker"
    fi
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
      /usr/share/plymouth/themes/@DISTRO_ID@/@DISTRO_ID@.plymouth 150
    if command -v update-initramfs >/dev/null && [ -d /boot ] && ls /boot/vmlinuz-* >/dev/null 2>&1; then
      update-initramfs -u
    fi
    ;;
esac
#DEBHELPER#
