Description: build.rs: set GIT_VERSION to a fixed string instead of asking git
 The upstream build.rs runs "git describe" and "git log" and panics when git is
 absent or the tree is not a git checkout, which is the case for a build from the
 release tarball. Omarchy's recipe (omacom/omarchy-pkgs,
 pkgbuilds/hyprland-preview-share-picker/PKGBUILD) replaces the file with this
 two-line version; the patch does the same so that dpkg-source carries the change.
Author: santisbon <santisbon@users.noreply.github.com>
Origin: vendor, https://github.com/omacom/omarchy-pkgs/blob/main/pkgbuilds/hyprland-preview-share-picker/PKGBUILD
Forwarded: not-needed
Last-Update: 2026-10-10
---
--- a/build.rs
+++ b/build.rs
@@ -1,30 +1,3 @@
 fn main() {
-    let version =
-        match std::process::Command::new("git").arg("describe").arg("--long").arg("--abbrev=7").arg("--tags").output() {
-            Ok(output) => {
-                let str = String::from_utf8_lossy(&output.stdout);
-                let split = str.trim().split('-').collect::<Vec<_>>();
-                format!("{}-r{}-{}", &split[0][1..], split[1], split[2])
-            }
-            Err(err) => {
-                println!("cargo::warning=Unable to get git version: {err:#}");
-                String::from("unknown")
-            }
-        };
-
-    let commit = match std::process::Command::new("git").arg("log").arg("--format=[%s]").arg("-n").arg("1").output() {
-        Ok(output) => {
-            if output.stdout.is_empty() {
-                String::from("unknown")
-            } else {
-                String::from_utf8_lossy(&output.stdout).trim().to_string()
-            }
-        }
-        Err(err) => {
-            println!("cargo::warning=Unable to get latest git commit: {err:#}");
-            String::from("unknown")
-        }
-    };
-
-    println!("cargo::rustc-env=GIT_VERSION={version} {commit}");
+    println!("cargo::rustc-env=GIT_VERSION=v0.2.1-r0-release");
 }
