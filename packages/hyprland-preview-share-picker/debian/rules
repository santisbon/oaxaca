#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# cargo keeps its registry cache under CARGO_HOME; a directory under debian/ keeps the
# chroot build from writing to $HOME. debian/clean removes the directory.
export CARGO_HOME = $(CURDIR)/debian/cargo_home

%:
	dh $@

# No debhelper build system matches a cargo tree (dh-cargo is not used), so the three
# dh_auto_* steps are spelled out.
#
# lib/hyprland-protocols is the git submodule, an empty directory in the release tarball;
# the symlink points the directory at the hyprland-protocols component that dpkg-source
# unpacked at the top of the tree. .cargo/config.toml is the text "cargo vendor" prints:
# the crates-io source is replaced by the vendor/ component, so cargo builds offline.
override_dh_auto_build:
	if [ -d lib/hyprland-protocols ] && [ ! -L lib/hyprland-protocols ]; then rmdir lib/hyprland-protocols; fi
	ln -sfn ../hyprland-protocols lib/hyprland-protocols
	mkdir -p .cargo
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > .cargo/config.toml
	cargo build --frozen --release
	target/release/hyprland-preview-share-picker schema > schema.json

override_dh_auto_install:
	install -D -m 0755 target/release/hyprland-preview-share-picker \
		debian/hyprland-preview-share-picker/usr/bin/hyprland-preview-share-picker
	install -D -m 0644 schema.json \
		debian/hyprland-preview-share-picker/usr/share/hyprland-preview-share-picker/schema.json

# debian/clean removes target/, .cargo/, debian/cargo_home/ and schema.json. The symlink
# gives way to the empty directory again, so the tree matches the orig tarball when
# dpkg-source compares the two.
override_dh_auto_clean:
	if [ -L lib/hyprland-protocols ]; then rm lib/hyprland-protocols; mkdir lib/hyprland-protocols; fi

# dh_clean deletes every *.orig file in the tree, and every vendored crate carries a
# Cargo.toml.orig that cargo checks against the crate's .cargo-checksum.json; the exclusion
# keeps those files, or cargo refuses to build.
override_dh_clean:
	dh_clean -XCargo.toml.orig

# A cargo release build carries no debug info, so the automatic dbgsym package would be
# empty; dh_strip is told not to make one.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
