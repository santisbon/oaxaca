+    // encryption passphrase was confirmed after a partition had been selected.
+    const QString selectedPath = current.data( PartitionModel::PartitionPathRole ).toString();
+    Partition* indexedPartition
+        = static_cast< Partition* >( current.data( PartitionModel::PartitionPtrRole ).value< void* >() );
+    const bool selectedIsFreeSpace = isPartitionFreeSpace( indexedPartition );
+    const qint64 selectedFirstSector = indexedPartition ? indexedPartition->firstSector() : -1;
+    const qint64 selectedLastSector = indexedPartition ? indexedPartition->lastSector() : -1;
+    QString extendedParentPath;
+    if ( indexedPartition && indexedPartition->parent() )
