# Ubuntu's GRUB and shim packages run grub-install in their maintainer scripts, which rewrites
# the EFI System Partition's /EFI/ubuntu/grub.cfg stub; re-apply the fallback to the previous
# system afterwards (/usr/libexec/@DISTRO_ID@/loader-fallback). noawait: nothing waits on it.
interest-noawait /usr/lib/grub/x86_64-efi-signed
interest-noawait /usr/lib/shim
# The thunderbolt module option (modprobe-thunderbolt.conf) is copied into the initramfs, so rebuild
# it when this package is installed or upgraded.
activate-noawait update-initramfs
