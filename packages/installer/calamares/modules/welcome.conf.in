# Requirements checked before the installer starts. The storage figure is the desktop root
# filesystem (3.5 GB) with room for the installed system's updates and a user's files.
---
showSupportUrl:         false
showKnownIssuesUrl:     false
showReleaseNotesUrl:    false
requirements:
    requiredStorage:    20
    requiredRam:        4
    internetCheckUrl:   https://archive.ubuntu.com
    check:
        - storage
        - ram
        - power
        - internet
        - root
    # internet is checked (the page says so when it is missing) but not required: the packages
    # the install-time hardware scripts add are in the image since 2026-10-11, Flathub's
    # metadata fetch only warns, and the drivers step (the NVIDIA driver from Ubuntu's archive,
    # docs/0 "Install on the target") is the one entry that needs the network, and its
    # shellprocess entry is marked to be skipped on failure; an offline install on an NVIDIA
    # machine boots on nouveau until @DISTRO_ID@-drivers-install is run with a network (docs/7,
    # choice 18).
    required:
        - root
        - storage
        - ram
geoip:
    style:  "none"
