# Partitioning as Lubuntu 26.10 configures it: GPT with an EFI System Partition at /boot/efi,
# ext4 by default (Ubuntu's default), optional LUKS2 full-disk encryption with an unencrypted
# /boot (Ubuntu's GRUB does not unlock LUKS2 itself, so /boot stays outside the encrypted
# volume), a swap file by default (hibernation is out of the first release, policy).
---
efiSystemPartition: "/boot/efi"
efiSystemPartitionSize: 512M
efiSystemPartitionName: "EFI"
enableLuksAutomatedPartitioning: true
# Encryption is the default: the "Encrypt system" box comes up checked for "Erase disk" and
# "Replace a partition" (Calamares 3.3.14 reads this in Config.cpp and applies it in ChoicePage,
# though its sample partition.conf documents it only from 3.4). The policy asks for an encrypted
# disk; a user who wants none unchecks the box (2026-10-12).
preCheckEncryption: true
luksGeneration: luks2
userSwapChoices:
    - none
    - file
initialSwapChoice: file
drawNestedPartitions: true
showNotEncryptedBootMessage: true
defaultFileSystemType: "ext4"
availableFileSystemTypes: ["ext4", "btrfs", "xfs"]
partitionLayout:
    - name: "@DISTRO_ID@_boot"
      filesystem: ext4
      noEncrypt: true
      onlyPresentWithEncryption: true
      mountPoint: "/boot"
      size: 4G
    - name: "@DISTRO_ID@_root"
      filesystem: unknown
      mountPoint: "/"
      size: 100%
