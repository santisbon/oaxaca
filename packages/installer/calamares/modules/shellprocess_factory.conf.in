# shellprocess@factory: from the live system (dontChroot), after the initramfs step and right
# before the umount step: on a btrfs root filesystem, take the read-only @factory snapshot that
# @DISTRO_ID@-system-factory-reset returns the machine to (factory-snapshot's header). Last, so
# the snapshot holds the finished system. The leading "-" keeps a failure from aborting the
# installation, which only leaves the machine without a factory reset; the target keeps the log
# in /var/log/@DISTRO_ID@/factory-snapshot.log. ${ROOT} is the target.
---
dontChroot: true
timeout: 300
script:
    - "-/usr/libexec/@DISTRO_ID@/factory-snapshot ${ROOT}"
