#!/bin/bash
# Generated from packages/installer/snapshots-setup.in by scripts/render.py. Edit the .in file, not this one.
# snapshots-setup: on a btrfs root filesystem, keep btrfs-progs and Timeshift in the target and
# point Timeshift at that filesystem, so oaxaca-update can take a snapshot before every update
# (oaxaca-snapshot); on any other root filesystem, do nothing. docs/7, choice 51.
#
# Anatomy: Calamares's shellprocess@snapshots runs this from the live system (dontChroot), right
# before the packages step, with the target's root as $1. The target is a copy of the live image,
# where btrfs-progs (Recommended by calamares) and Timeshift (a dependency of oaxaca-live) are
# installed as dependencies; the packages step then removes the live session's packages and runs
# "apt-get autoremove", which takes both away unless they are marked as installed by hand. This
# step marks them on a btrfs root only, so an ext4 or xfs install loses them as before. Timeshift's
# configuration, /etc/timeshift/timeshift.json (JSON), is written from Timeshift's own
# /etc/timeshift/default.json with the root filesystem's UUID and, on an encrypted install, the LUKS
# partition's UUID; no schedule is turned on. The log goes to
# /var/log/oaxaca/snapshots-setup.log in the target.
# Usage: snapshots-setup <target root>
set -u
root=${1:?target root}
mkdir -p "$root/var/log/oaxaca"
exec > >(tee -a "$root/var/log/oaxaca/snapshots-setup.log") 2>&1

fstype=$(findmnt -no FSTYPE --mountpoint "$root")
if [ "$fstype" != btrfs ]; then
    echo "oaxaca-snapshots-setup: root filesystem is ${fstype:-unknown}; no snapshots"
    exit 0
fi

# findmnt prints a btrfs subvolume mount as "<device>[/<subvolume>]".
source=$(findmnt -no SOURCE --mountpoint "$root")
device=${source%%\[*}
fs_uuid=$(blkid -s UUID -o value "$device")
luks=$(lsblk -nrps -o NAME,FSTYPE "$device" | awk '$2 == "crypto_LUKS" { print $1; exit }')
luks_uuid=""
[ -n "$luks" ] && luks_uuid=$(blkid -s UUID -o value "$luks")
echo "oaxaca-snapshots-setup: btrfs root $device (UUID $fs_uuid); LUKS partition: ${luks:-none}"

chroot "$root" apt-mark manual btrfs-progs timeshift || exit 1

template="$root/etc/timeshift/default.json"
[ -f "$template" ] || { echo "oaxaca-snapshots-setup: $template is missing" >&2; exit 1; }
sed -e "s|\"backup_device_uuid\" : \"[^\"]*\"|\"backup_device_uuid\" : \"$fs_uuid\"|" \
    -e "s|\"parent_device_uuid\" : \"[^\"]*\"|\"parent_device_uuid\" : \"$luks_uuid\"|" \
    -e 's|"do_first_run" : "[^"]*"|"do_first_run" : "false"|' \
    -e 's|"btrfs_mode" : "[^"]*"|"btrfs_mode" : "true"|' \
    "$template" > "$root/etc/timeshift/timeshift.json" || exit 1
echo "oaxaca-snapshots-setup: wrote /etc/timeshift/timeshift.json:"
cat "$root/etc/timeshift/timeshift.json"
